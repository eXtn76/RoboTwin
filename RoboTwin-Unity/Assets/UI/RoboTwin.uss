/* Gemeinsames Stylesheet für alle RoboTwin-Panels. */

/* Halbtransparenter Kasten oben links über der 3D-Szene. */
.panel {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 600px;
    padding: 12px 16px;
    background-color: rgba(24, 26, 30, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

.panel-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 232, 235);
    margin-bottom: 8px;
}

/* Eine Zeile: Elemente nebeneinander, vertikal mittig. */
.row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.row-label {
    width: 150px;
    color: rgb(201, 205, 210);
}

/* Slider füllt den Restplatz der Zeile. */
.row-slider {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
}

/* Eingabefeld rechts am Slider: feste Breite, damit alle Zeilen fluchten. */
.row-slider .unity-base-slider__text-field {
    width: 64px;
}

#joint-rows {
    margin-top: 8px;
    margin-bottom: 8px;
}

.actual-caption {
    color: rgb(138, 144, 153);
}

/* Ist-Wert: feste Breite und rechtsbündig, damit die Zahl beim Ändern nicht springt. */
.actual-value {
    width: 70px;
    -unity-text-align: middle-right;
    color: rgb(127, 209, 255);
}

.tcp {
    color: rgb(127, 209, 255);
    margin-bottom: 4px;
}

.footer {
    margin-top: 8px;
}

.button {
    min-width: 80px;
    height: 28px;
}

.button-stop {
    background-color: rgb(179, 38, 30);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.button-stop:hover {
    background-color: rgb(208, 54, 44);
}

.status {
    color: rgb(201, 205, 210);
    margin-bottom: 6px;
}

/* ---- Kartesisch-Panel ---- */

/* Variante des Panels: oben rechts statt oben links. */
.panel--right {
    left: auto;
    right: 16px;
    width: 380px;
}

.coord-field {
    margin-top: 2px;
    margin-bottom: 2px;
}

/* Beschriftung links im Feld ("X", "Werkzeug", ...). */
.coord-field > .unity-base-field__label {
    min-width: 90px;
    color: rgb(201, 205, 210);
}

/* Meldung unter den Buttons; darf umbrechen. */
.message {
    margin-top: 8px;
    white-space: normal;
}

.message--ok {
    color: rgb(120, 220, 140);
}

.message--error {
    color: rgb(255, 120, 110);
}

/* ---- Verbindungszeile ---- */

.connection-bar {
    margin-bottom: 8px;
}

.connection-mode {
    width: 160px;
    margin-right: 8px;
}

.connection-status {
    flex-grow: 1;
    -unity-text-align: middle-right;
}

/* ---- Netzwerk-Einstellungen ---- */

.network-settings {
    margin-bottom: 4px;
}

.network-host {
    flex-grow: 1;
}

.network-port {
    width: 130px;
    margin-left: 8px;
}

.network-settings .unity-base-field__label {
    min-width: 40px;
    color: rgb(201, 205, 210);
}

.connection-role {
    margin-left: 8px;
    color: rgb(201, 205, 210);
}

.message--warning {
    color: rgb(255, 196, 90);
}

/* ---- Not-Halt ---- */

.safety-bar {
    margin-top: 4px;
    margin-bottom: 8px;
}

/* Groß, rot, nicht zu übersehen – wie der Pilztaster am echten Pendant. */
.button-emergency {
    flex-grow: 1;
    height: 40px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(200, 20, 20);
    border-width: 2px;
    border-color: rgb(255, 210, 0);
}

.button-emergency:hover {
    background-color: rgb(230, 30, 30);
}

/* ---- Programm-Panel ---- */

/* Rechte Spalte, UNTEN verankert: wächst nach oben und kann so das Kartesisch-Panel
   (oben rechts) nicht überdecken. Beide sind eigene UI Documents und wissen nichts voneinander. */
.panel--program {
    top: auto;
    bottom: 16px;
    width: 480px;
}

.program-hint {
    color: rgb(138, 144, 153);
    font-size: 11px;
    margin-top: 4px;
    margin-bottom: 2px;
}

.point-list {
    min-height: 60px;
    max-height: 230px;
    margin-bottom: 6px;
}

.point-index {
    width: 22px;
    color: rgb(138, 144, 153);
}

.point-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.point-speed {
    width: 50px;
}

.point-wait {
    width: 50px;
}

.unit {
    color: rgb(138, 144, 153);
    margin-right: 4px;
}

.point-button {
    width: 26px;
    margin-left: 1px;
    margin-right: 1px;
}

/* Der Punkt, den das Programm gerade anfährt. */
.program-row--active {
    background-color: rgba(127, 209, 255, 0.18);
    border-radius: 4px;
}

/* Dateiauswahl darf schrumpfen, damit beide Buttons daneben Platz haben. */
.file-select {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.file-select > .unity-base-field__label {
    min-width: 40px;
    color: rgb(201, 205, 210);
}

.button--small {
    min-width: 0;
    padding-left: 8px;
    padding-right: 8px;
}

.loop-toggle {
    margin-left: 8px;
}

.loop-toggle > .unity-base-field__label {
    min-width: 80px;
    color: rgb(201, 205, 210);
}

/* ---- Einklappbare Bereiche (Foldout) ---- */

/* Überschrift des Foldouts sieht aus wie ein Panel-Titel. */
.panel-foldout .unity-foldout__text {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 232, 235);
}

/* Inhalt nicht einrücken (Standard sind 15 px). */
.panel-foldout > .unity-foldout__content {
    margin-left: 0;
}

/* ---- Bedienhinweis unten links ---- */

.controls-hint {
    position: absolute;
    left: 16px;
    bottom: 12px;
    padding: 4px 8px;
    font-size: 12px;
    color: rgb(230, 232, 235);
    background-color: rgba(24, 26, 30, 0.7);
    border-radius: 4px;
}
