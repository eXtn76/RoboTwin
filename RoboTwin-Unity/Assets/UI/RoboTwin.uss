/* Gemeinsames Stylesheet für alle RoboTwin-Panels. */

/* Halbtransparenter Kasten oben links über der 3D-Szene. */
.panel {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 600px;
    padding: 12px 16px;
    background-color: rgba(24, 26, 30, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}

.panel-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 232, 235);
    margin-bottom: 8px;
}

/* Eine Zeile: Elemente nebeneinander, vertikal mittig. */
.row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.row-label {
    width: 150px;
    color: rgb(201, 205, 210);
}

/* Slider füllt den Restplatz der Zeile. */
.row-slider {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
}

/* Eingabefeld rechts am Slider: feste Breite, damit alle Zeilen fluchten. */
.row-slider .unity-base-slider__text-field {
    width: 64px;
}

#joint-rows {
    margin-top: 8px;
    margin-bottom: 8px;
}

.actual-caption {
    color: rgb(138, 144, 153);
}

/* Ist-Wert: feste Breite und rechtsbündig, damit die Zahl beim Ändern nicht springt. */
.actual-value {
    width: 70px;
    -unity-text-align: middle-right;
    color: rgb(127, 209, 255);
}

.tcp {
    color: rgb(127, 209, 255);
    margin-bottom: 4px;
}

.footer {
    margin-top: 8px;
}

.button {
    min-width: 80px;
    height: 28px;
}

.button-stop {
    background-color: rgb(179, 38, 30);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.button-stop:hover {
    background-color: rgb(208, 54, 44);
}

.status {
    flex-grow: 1;
    -unity-text-align: middle-right;
    color: rgb(201, 205, 210);
}

/* ---- Kartesisch-Panel ---- */

/* Variante des Panels: oben rechts statt oben links. */
.panel--right {
    left: auto;
    right: 16px;
    width: 380px;
}

.coord-field {
    margin-top: 2px;
    margin-bottom: 2px;
}

/* Beschriftung links im Feld ("X", "Werkzeug", ...). */
.coord-field > .unity-base-field__label {
    min-width: 90px;
    color: rgb(201, 205, 210);
}

/* Meldung unter den Buttons; darf umbrechen. */
.message {
    margin-top: 8px;
    white-space: normal;
}

.message--ok {
    color: rgb(120, 220, 140);
}

.message--error {
    color: rgb(255, 120, 110);
}

/* ---- Verbindungszeile ---- */

.connection-bar {
    margin-bottom: 8px;
}

.connection-mode {
    width: 160px;
    margin-right: 8px;
}

.connection-status {
    flex-grow: 1;
    -unity-text-align: middle-right;
}

/* ---- Netzwerk-Einstellungen ---- */

.network-settings {
    margin-bottom: 4px;
}

.network-host {
    flex-grow: 1;
}

.network-port {
    width: 130px;
    margin-left: 8px;
}

.network-settings .unity-base-field__label {
    min-width: 40px;
    color: rgb(201, 205, 210);
}

.connection-role {
    margin-left: 8px;
    color: rgb(201, 205, 210);
}

.message--warning {
    color: rgb(255, 196, 90);
}
