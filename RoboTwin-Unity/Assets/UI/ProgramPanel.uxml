<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="RoboTwin.uss" />

    <!-- Programme (Teach-Pendant-Prinzip): Positionen speichern, Liste bearbeiten, abspielen,
         als JSON speichern/laden. Die Punktzeilen erzeugt ProgramPanel.cs aus ProgramRow.uxml. -->
    <ui:VisualElement name="program-panel" class="panel panel--right panel--program">
        <ui:Foldout text="Programm" value="true" class="panel-foldout">
        <ui:TextField name="program-name" label="Name" class="coord-field" />

        <!-- Erklärung statt Spaltenüberschriften: Überschriften müssten pixelgenau über Feldern
             mit eigenen Innenabständen stehen – das bricht leicht. -->
        <ui:Label text="Name · Speed % · Wartezeit s · -&gt; anfahren · ^ v verschieben · x löschen" class="program-hint" />
        <ui:ScrollView name="point-list" class="point-list" />

        <ui:VisualElement class="row">
            <ui:Button name="teach-button" text="Position speichern" class="button" />
            <ui:Button name="new-button" text="Neu" class="button" />
        </ui:VisualElement>

        <ui:VisualElement class="row">
            <ui:DropdownField name="file-select" label="Datei" class="file-select" />
            <ui:Button name="load-button" text="Laden" class="button button--small" />
            <ui:Button name="save-button" text="Speichern" class="button button--small" />
        </ui:VisualElement>

        <ui:VisualElement class="row footer">
            <ui:Button name="play-button" text="Start" class="button" />
            <ui:Button name="pause-button" text="Pause" class="button" />
            <ui:Button name="program-stop-button" text="Stop" class="button" />
            <ui:Toggle name="loop-toggle" label="Wiederholen" class="loop-toggle" />
        </ui:VisualElement>
        </ui:Foldout>

        <!-- Meldung außerhalb des Foldouts: Ein laufendes Programm zeigt seinen Fortschritt auch eingeklappt. -->
        <ui:Label name="program-message" text="" class="message" />
    </ui:VisualElement>
</ui:UXML>
